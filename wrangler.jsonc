{
  // AMAS-5 (24/11/2026): eigen config zoals bij Clinic3D en 't Kleinhof
  // (kennis 06), voor een echte 404-pagina. Naam = de bestaande Worker
  // "amakhosi" (nagekeken via de Cloudflare-API op 24/11). compatibility_date
  // gelijk aan Clinic3D en 't Kleinhof (werkt daar sinds oktober); voor een
  // Worker met alleen statische bestanden verandert die datum niets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amakhosi",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  }
}
